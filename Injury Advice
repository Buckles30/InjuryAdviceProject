import ast
import streamlit as st
import pandas as pd

st.title("Injury Tracker GAA")
st.subheader("Predicting injury timeline based on a dataset.")

def PLEASEWORK(val):
    if pd.isna(val):
        return None
    if isinstance(val, str):
        try:
            return ast.literal_eval(val)
        except (ValueError, SyntaxError):
            return val
    return val

def cleanatron(injury_text):
    text = str(injury_text).lower()
    if 'hamstring' in text:
        return 'Hamstring'
    elif 'ankle' in text:
        return 'Ankle'
    elif 'knee' in text or 'acl' in text or 'meniscus' in text:
        return 'Knee'
    elif 'shoulder' in text or 'collarbone' in text:
        return 'Shoulder'
    elif 'calf' in text:
        return 'Calf'
    elif 'groin' in text:
        return 'Groin'
    elif 'concussion' in text or 'head' in text:
        return 'Head / Concussion'
    elif 'quad' in text or 'thigh' in text:
        return 'Quad'
    else:
        return 'Other'

df = pd.read_csv('Injuries.csv')

df['Days'] = df['Days'].str.replace(' days', '').astype(float)

df['Clean_Injury'] = df['Injury'].apply(cleanatron)
df['Injury'] = df['Injury'].apply(PLEASEWORK)

user_injury = pd.DataFrame() 
selected_other = None        

with st.sidebar:
    st.header("Log a New Injury")
    st.write("Add a recent case to the database.")
    
    with st.form("add_injury_form"):
        new_age = st.number_input("Player Age", min_value=16, max_value=50, value=22)
        new_injury = st.text_input("Injury Name (e.g., Hamstring, Broken Toe)")
        new_days = st.number_input("Days to Recover", min_value=1, max_value=365, value=14)
        
        submitted = st.form_submit_button("Save to Database")
        
        if submitted:
            formatted_days = f"{new_days} days"
            
            new_row = pd.DataFrame({
                'player_age': [new_age],
                'Injury': [new_injury],
                'Days': [formatted_days]
            })
            
            new_row.to_csv('Injuries.csv', mode='a', header=False, index=False)
            
            st.success(f"Successfully logged: {new_injury} ({new_days} days)")
            st.rerun()

st.divider()

injury = st.selectbox('Select an injury area:', df['Clean_Injury'].sort_values().unique(), index=None)

age = st.slider('Select player age:', 16, 40, 22)
min_age = age - 3
max_age = age + 3

if injury == 'Other':
    search = st.text_input('Search specific injury (e.g., thumb, toe):')
    other_df = df[df['Clean_Injury'] == 'Other']

    if search:
        mask = other_df['Injury'].astype(str).str.contains(search, case=False, na=False)
        results = other_df[mask]
    else:
        results = other_df

    if not results.empty:
        selected_other = st.selectbox(
            'Matching injuries found:',
            results['Injury'].unique(),
            index=None
        )
    else:
        st.write('No injuries match your search.')

if injury == 'Other' and selected_other:
    user_injury = df[ 
        (df['Injury'] == selected_other) &
        (df['player_age'] >= min_age) & 
        (df['player_age'] <= max_age) 
    ]

elif injury != 'Other' and injury:
    user_injury = df[ 
        (df['Clean_Injury'] == injury) & 
        (df['player_age'] >= min_age) & 
        (df['player_age'] <= max_age) 
    ]

st.divider()
st.subheader("Data Analysis")

case_count = len(user_injury)

col1, col2 = st.columns(2)

with col1:
    if case_count > 0:
        average_time = user_injury['Days'].mean()
        clean_days = round(average_time)
        st.metric(label="Estimated Return to Play", value=f"{clean_days} Days")
    else:
        st.metric(label="Estimated Return to Play", value="N/A")

with col2:
    if case_count < 15:
        st.metric(label="Cases Found (Low Confidence)", value=case_count, delta="Need more historical data", delta_color="inverse")
    else:
        st.metric(label="Cases Found (High Confidence)", value=case_count)

st.divider()
st.subheader("Positional Breakdown")

if case_count > 0 and 'player_position' in user_injury.columns:
    position_counts = user_injury['player_position'].value_counts()
    st.bar_chart(position_counts)
